# Required to retrieve OpenAQ data. Never commit the real .env file.
OPENAQ_API_KEY=replace_with_your_openaq_key

# Required only when running database load scripts.
# Example: postgresql+psycopg2://username:password@localhost:5432/aqi_database
AQI_DATABASE_URL=

# Optional pipeline configuration. Defaults target Delhi.
AQI_CITY=Delhi
AQI_LATITUDE=28.6139
AQI_LONGITUDE=77.2090
AQI_RADIUS_DEGREES=0.50
OPENAQ_MAX_STATIONS=20

# Optional reproducible backfill window (YYYY-MM-DD).
# Leave blank to retrieve the previous 30 complete days.
WEATHER_START_DATE=
WEATHER_END_DATE=
ANALYSIS_START_DATE=
ANALYSIS_END_DATE=
